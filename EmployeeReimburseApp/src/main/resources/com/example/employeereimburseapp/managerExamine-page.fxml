<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.employeereimburseapp.ManagerExamineController">

    <children>

        <Label text="Request Details"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <GridPane hgap="10" vgap="8">
            <children>

                <Label text="Request ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="reqIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="User ID:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="userIdLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Location:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label fx:id="locationLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Expense Type:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <Label fx:id="expenseTypeLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <Label text="Cost:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <Label fx:id="costLabel" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <Label text="Reason:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <Label fx:id="reasonLabel" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                <Label text="Receipt URL:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <Label fx:id="receiptUrlLabel" GridPane.rowIndex="6" GridPane.columnIndex="1" />

            </children>
        </GridPane>

        <HBox spacing="10">
            <children>
                <Button text="Approve" fx:id="approveBtn" onAction="#approve" />
                <Button text="Reject" fx:id="rejectBtn" onAction="#reject" />
            </children>
        </HBox>

    </children>

    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

</VBox>

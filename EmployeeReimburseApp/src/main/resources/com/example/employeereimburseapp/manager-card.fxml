<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.employeereimburseapp.CardManager">
   <children>
      <GridPane prefHeight="30.0" prefWidth="642.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" />
          <ColumnConstraints hgrow="SOMETIMES" />
          <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
            <ColumnConstraints hgrow="SOMETIMES" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label fx:id="reqLbl" text="RequestID" GridPane.columnIndex="1" />
            <Label fx:id="locLbl" text="Location" GridPane.columnIndex="2" />
            <Label fx:id="costLbl" text="Cost" GridPane.columnIndex="3" />
            <Label fx:id="statusLbl" text="Status" GridPane.columnIndex="4" />
            <Button mnemonicParsing="false" onAction="#examineReq" prefHeight="26.0" prefWidth="80.0" text="Examine" GridPane.columnIndex="5" />
            <Label fx:id="userIdLbl" text="EmployeeID" />
         </children>
      </GridPane>
   </children>
</AnchorPane>
